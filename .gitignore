# Data (not redistributed). Folders stay in the repo through .gitkeep files.
data/raw/*
data/processed/*
data/satellite/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/satellite/.gitkeep

# Large or derived files
*.parquet
*.nc
*.tif
*.tiff
*.zip

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Environments and secrets
.env
.venv/
venv/
*.key
credentials*.json

# Editors and system files
.vscode/
.idea/
.DS_Store
Thumbs.db